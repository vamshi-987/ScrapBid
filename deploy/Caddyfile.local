# Local development: everything on http://localhost.
{
	auto_https off
	admin off
}

:80 {
	@django path /api /api/* /admin /admin/* /static/*
	reverse_proxy @django backend:8000

	# Presigned links to private photos. The bucket stays private: MinIO checks
	# each link's signature, which is made for this host (S3_PUBLIC_ENDPOINT_URL).
	@storage path /{$S3_BUCKET}/*
	reverse_proxy @storage minio:9000

	# Vite dev server, including hot-reload websockets.
	reverse_proxy frontend:5173
}
