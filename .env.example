# Copy to .env for local development: cp .env.example .env
# Every value here is a safe local default. Production values go in the server's .env only.

# --- Django ---
# "local" or "production". Production refuses to start with unsafe values (see RUNBOOK.md).
DJANGO_ENV=local
DJANGO_DEBUG=True
# Leave empty locally to use the built-in dev key. Production must set a long random value.
DJANGO_SECRET_KEY=
# Comma-separated host names the backend answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostGIS) ---
POSTGRES_DB=scrapbid
POSTGRES_USER=scrapbid
POSTGRES_PASSWORD=scrapbid
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Object storage (S3 API) ---
# Locally this is MinIO. In production, leave S3_ENDPOINT_URL empty to use AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=scrapbid-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=scrapbid
S3_SECRET_ACCESS_KEY=scrapbid-secret
# Address the browser uses to open presigned photo links. Locally Caddy forwards
# http://localhost/<bucket>/... to MinIO. In production, leave empty to use AWS S3.
S3_PUBLIC_ENDPOINT_URL=http://localhost
# How long a presigned photo link works, in seconds.
PRESIGNED_URL_TTL_SECONDS=600

# MinIO login, local only. Matches the S3 keys above.
MINIO_ROOT_USER=scrapbid
MINIO_ROOT_PASSWORD=scrapbid-secret
# Host port for the MinIO console (http://localhost:9001). Change it if 9001 is taken.
MINIO_CONSOLE_PORT=9001

# --- Dealer onboarding ---
# Largest verification document a dealer can upload, in bytes (10 MB).
DEALER_DOCUMENT_MAX_BYTES=10485760

# --- Listings ---
# Largest listing photo, in bytes (10 MB), and the most photos per listing.
LISTING_PHOTO_MAX_BYTES=10485760
LISTING_MAX_PHOTOS=6
# Largest declared weight for one category on a listing, in kg.
LISTING_MAX_WEIGHT_KG=10000
# Open listings with no accepted offer expire this many days after publishing.
LISTING_EXPIRY_DAYS=7

# --- Offers ---
# Offers are estimates at the day's rates; they expire this many hours after being made.
OFFER_EXPIRY_HOURS=24

# --- Pickups ---
# Slots are PICKUP_SLOT_HOURS long, between these IST hours, starting at least
# PICKUP_MIN_NOTICE_HOURS from now and at most PICKUP_MAX_DAYS_AHEAD days ahead.
PICKUP_SLOT_HOURS=2
PICKUP_DAY_START_HOUR=8
PICKUP_DAY_END_HOUR=20
PICKUP_MIN_NOTICE_HOURS=2
PICKUP_MAX_DAYS_AHEAD=7
# Reschedule requests close this many hours before the confirmed slot.
PICKUP_RESCHEDULE_DEADLINE_HOURS=2
# The dealer must be this close (metres) to the pickup point to check in or enter the weight.
PICKUP_MAX_DISTANCE_METERS=200
# A missed pickup is recorded this many minutes after a confirmed slot ends.
NO_SHOW_GRACE_MINUTES=30
# A no-show costs the side that missed it this penalty, in paise (10000 = 100 rupees). They're
# blocked until it's paid (sellers can't publish, dealers can't offer).
NO_SHOW_PENALTY_PAISE=10000
# A no-show strike can be challenged to an admin within this many hours.
STRIKE_CHALLENGE_HOURS=48

# --- Weighing ---
# A verified weight within this percentage of the declared weight counts as equal:
# the dealer pays the verified weight and can't deny the pickup.
WEIGHT_TOLERANCE_PERCENT=5
# The seller's 6-digit handover code: minutes it stays valid, and wrong tries allowed.
# The seller can show a fresh code at any time.
HANDOVER_CODE_EXPIRY_MINUTES=15
HANDOVER_CODE_MAX_ATTEMPTS=5
# Rate flags for admins: a dealer's average rate for a category over the window, more than
# this percent above the other dealers' average, with at least this many other dealers.
RATE_FLAG_THRESHOLD_PERCENT=20
RATE_FLAG_WINDOW_DAYS=30
RATE_FLAG_MIN_PEERS=3
# Upheld disputes against a dealer (since their last suspension) that suspend them from
# selling and buying, and the fee in paise to lift a suspension. The fee doubles from the
# Nth suspension on (500, 500, 1,000, 2,000 rupees with the defaults).
AUTO_SUSPEND_UPHELD_DISPUTES=3
SUSPENSION_FEE_PAISE=50000
SUSPENSION_FEE_DOUBLES_FROM=3
# Penalties and fees are paid online. "fake" (local only) simulates the gateway with a local
# pay page and the same signed callback; production must use "razorpay" with real keys
# (Razorpay Dashboard > Account & Settings > API Keys). Production refuses to start otherwise.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Where the app is reached; the gateway sends users back to APP_BASE_URL/api/payments/callback.
# Must be https:// in production.
APP_BASE_URL=http://localhost

# --- Scheduler ---
# How often the scheduler service runs scheduled jobs, in seconds.
SCHEDULER_INTERVAL_SECONDS=300

# --- OTP ---
# "console" prints OTP codes to the backend logs (local only). Production uses "msg91".
OTP_PROVIDER=console
# Fixed OTP for demo logins, local only, 6 digits. Used only with OTP_PROVIDER=console.
# Must be empty in production.
DEV_FIXED_OTP=123456
# Login code lifetime, in seconds.
OTP_EXPIRY_SECONDS=300
# Wrong attempts allowed per code before it stops working.
OTP_MAX_ATTEMPTS=5
# Login code requests allowed per phone number, in 10 minutes and in 24 hours.
OTP_MAX_REQUESTS_PER_PHONE_10_MIN=3
OTP_MAX_REQUESTS_PER_PHONE_DAY=10
# Login code requests allowed per IP address, per hour.
OTP_MAX_REQUESTS_PER_IP_HOUR=20
